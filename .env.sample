# Copy to .env and `source .env` before running anything in bench/.
export SPARK_BASE_URL=http://localhost:18300/v1
export SPARK_MODEL=qwen3.8-flash-next
export SPARK_API_KEY=
# The snapshot every number in this repo was measured on. Pin it with
# REVISION=$SNAPSHOT_SHA before ./serve.sh (README, Weights) so a cache holding
# more than one snapshot cannot pick the wrong one silently.
export SNAPSHOT_SHA=7b719225242aacd3dbd3f9407468c2ee9a9d2594
